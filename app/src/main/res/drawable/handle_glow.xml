<?xml version="1.0" encoding="utf-8"?>
<!-- Soft halo behind the side handle: stacked strokes fade outward. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke android:width="12dp" android:color="@color/handle_glow_outer" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="7dp" android:color="@color/handle_glow_mid" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <stroke android:width="3dp" android:color="@color/handle_glow_core" />
        </shape>
    </item>
</layer-list>
