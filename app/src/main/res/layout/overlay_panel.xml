<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_bg"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/panel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_factcheck_mark"
            app:tint="@color/panel_accent" />

        <TextView
            android:id="@+id/panel_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textColor="@color/panel_text"
            android:textSize="14sp"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/panel_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="-6dp"
            android:gravity="center"
            android:contentDescription="@string/app_name"
            android:text="✕"
            android:textColor="@color/panel_text_mute"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View
        android:id="@+id/panel_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/divider_accent" />

    <ScrollView
        android:id="@+id/panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/panel_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/panel_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/panel_open"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="@color/panel_text_mute"
            android:textSize="13sp"
            android:text="@string/panel_open" />

        <TextView
            android:id="@+id/panel_copy"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="@color/panel_text_mute"
            android:textSize="13sp"
            android:text="@string/panel_copy" />

        <TextView
            android:id="@+id/panel_recheck"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="@color/panel_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="@string/panel_recheck" />
    </LinearLayout>
</LinearLayout>
